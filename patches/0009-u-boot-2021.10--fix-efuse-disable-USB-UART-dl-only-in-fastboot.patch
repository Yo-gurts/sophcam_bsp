From 3c41fc0b2b04421e532a0d3cfeacb64c32c13ccd Mon Sep 17 00:00:00 2001
From: "song.yu" <song.yu@sophgo.com>
Date: Thu, 19 Mar 2026 16:02:26 +0800
Subject: [PATCH] [fix](efuse): disable USB/UART dl only in fastboot
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SD 卡烧录功能不禁用

Change-Id: I551d8c78bb8f950f9b9628a13e2363371b93918e
---
 cmd/efuse.c | 20 ++++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

diff --git a/cmd/efuse.c b/cmd/efuse.c
index 64dfd39158..44473384f3 100644
--- a/cmd/efuse.c
+++ b/cmd/efuse.c
@@ -509,14 +509,18 @@ CVI_S32 CVI_EFUSE_EnableFastBoot(void)
 
 	ret = _CVI_EFUSE_Write(CVI_EFUSE_CUSTOMER_ADDR, &value, sizeof(value));
 	if (ret < 0)
-		return ret;
-
-	// set sd dl button
-	value = (0x1 << 22);
-	value |= (0x1 << 24);
-	value |= (0x1 << 26);
-
-	return _CVI_EFUSE_Write(CVI_EFUSE_SW_INFO, &value, sizeof(value));
+          return ret;
+
+        // set sd dl button
+        value = 0;
+        // value |= (0x1 << 22); // SD DL Disable; {bit22:23, 0b00/0b11: SD DL
+        // Enable; 0b01: Fastboot Mode; 0b10: Disable}
+        value |= (0x1 << 24); // USB DL Disable; {bit24:25, 0b00/0b11: USB DL
+                              // Enable; 0b01: Fastboot Mode; 0b10: Disable}
+        value |= (0x1 << 26); // UART DL Disable; {bit26:27, 0b00/0b11: UART DL
+                              // Enable; 0b01: Fastboot Mode; 0b10: Disable}
+
+        return _CVI_EFUSE_Write(CVI_EFUSE_SW_INFO, &value, sizeof(value));
 }
 
 CVI_S32 CVI_EFUSE_IsFastBootEnabled(void)
-- 
2.25.1

