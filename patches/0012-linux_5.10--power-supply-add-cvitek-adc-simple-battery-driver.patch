diff --git a/drivers/power/supply/adc-simple-battery.c b/drivers/power/supply/adc-simple-battery.c
new file mode 100644
index 000000000..0b23d2390
--- /dev/null
+++ b/drivers/power/supply/adc-simple-battery.c
@@ -0,0 +1,532 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Simple ADC battery driver
+ *
+ * Copyright (C) 2026 CVITEK
+ */
+
+#include <linux/gpio/consumer.h>
+#include <linux/iio/consumer.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/workqueue.h>
+
+#define ASB_DEF_POLL_MS		5000
+#define ASB_VOLTAGE_HYST_UV	20000
+#define ASB_DEF_FILTER_ALPHA	250
+#define ASB_DEF_STEP_UP_PCT	2
+#define ASB_DEF_STEP_DOWN_PCT	1
+#define ASB_DEF_DROP_UV		120000
+#define ASB_DEF_DROP_HOLD_MS	3000
+
+struct asb_state {
+	int voltage_uv;
+	int capacity;
+	int status;
+	int temp_decic;
+};
+
+struct adc_simple_battery {
+	struct device *dev;
+	struct iio_channel *vbat_chan;
+	struct iio_channel *temp_chan;
+	struct gpio_desc *charge_status_gpiod;
+
+	struct power_supply_desc desc;
+	struct power_supply *psy;
+	struct power_supply_battery_info info;
+
+	struct delayed_work poll_work;
+	unsigned int poll_interval_ms;
+	unsigned int voltage_scale;
+	unsigned int filter_alpha_permil;
+	int cap_step_up_pct;
+	int cap_step_down_pct;
+	int transient_drop_uv;
+	unsigned int transient_hold_ms;
+	bool use_status_gpio;
+	bool has_temp_channel;
+	bool has_prev;
+	bool has_filtered_voltage;
+	bool has_smoothed_capacity;
+	bool state_valid;
+
+	unsigned long transient_hold_until;
+	int filtered_voltage_uv;
+	int smoothed_capacity;
+
+	struct mutex lock; /* Protect filter state and cached output state. */
+	struct asb_state state;
+	struct asb_state prev;
+};
+
+static int asb_read_voltage_uv(struct adc_simple_battery *asb, int *uv)
+{
+	int ret, raw;
+	s64 value;
+
+	ret = iio_read_channel_processed(asb->vbat_chan, &raw);
+	if (ret < 0)
+		return ret;
+
+	/* Most ADC battery channels report mV, while power_supply uses uV. */
+	value = raw;
+	if (abs(raw) < 20000)
+		value *= 1000;
+
+	value = div_s64(value * asb->voltage_scale, 1000);
+	*uv = clamp_t(int, value, 0, INT_MAX);
+
+	return 0;
+}
+
+static int asb_read_temp_decic(struct adc_simple_battery *asb, int *decic)
+{
+	int ret, raw;
+
+	if (!asb->has_temp_channel)
+		return -ENODATA;
+
+	ret = iio_read_channel_processed(asb->temp_chan, &raw);
+	if (ret < 0)
+		return ret;
+
+	/* POWER_SUPPLY_PROP_TEMP uses tenths of Celsius. */
+	if (abs(raw) > 1000)
+		*decic = raw / 100;
+	else
+		*decic = raw * 10;
+
+	return 0;
+}
+
+static int asb_capacity_level(int cap)
+{
+	if (cap <= 5)
+		return POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL;
+	if (cap <= 15)
+		return POWER_SUPPLY_CAPACITY_LEVEL_LOW;
+	if (cap >= 95)
+		return POWER_SUPPLY_CAPACITY_LEVEL_FULL;
+	if (cap >= 80)
+		return POWER_SUPPLY_CAPACITY_LEVEL_HIGH;
+
+	return POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
+}
+
+static int asb_get_status(struct adc_simple_battery *asb, int cap)
+{
+	int charging;
+
+	if (asb->use_status_gpio) {
+		charging = gpiod_get_value_cansleep(asb->charge_status_gpiod);
+		if (charging < 0)
+			return POWER_SUPPLY_STATUS_UNKNOWN;
+	} else {
+		charging = power_supply_am_i_supplied(asb->psy) > 0;
+	}
+
+	if (charging)
+		return cap >= 100 ? POWER_SUPPLY_STATUS_FULL :
+					    POWER_SUPPLY_STATUS_CHARGING;
+
+	return POWER_SUPPLY_STATUS_DISCHARGING;
+}
+
+static int asb_get_capacity(struct adc_simple_battery *asb,
+			    int voltage_uv, int temp_c)
+{
+	int cap;
+
+	cap = power_supply_batinfo_ocv2cap(&asb->info, voltage_uv, temp_c);
+	if (cap >= 0)
+		return clamp_t(int, cap, 0, 100);
+
+	if (asb->info.voltage_min_design_uv <= 0 ||
+	    asb->info.voltage_max_design_uv <= asb->info.voltage_min_design_uv)
+		return -EINVAL;
+
+	cap = (voltage_uv - asb->info.voltage_min_design_uv) * 100;
+	cap /= asb->info.voltage_max_design_uv - asb->info.voltage_min_design_uv;
+
+	return clamp_t(int, cap, 0, 100);
+}
+
+static int asb_filter_voltage_uv(struct adc_simple_battery *asb, int raw_uv)
+{
+	s64 filt;
+
+	if (!asb->has_filtered_voltage) {
+		asb->filtered_voltage_uv = raw_uv;
+		asb->has_filtered_voltage = true;
+		return raw_uv;
+	}
+
+	filt = (s64)asb->filter_alpha_permil * raw_uv;
+	filt += (s64)(1000 - asb->filter_alpha_permil) * asb->filtered_voltage_uv;
+	filt = div_s64(filt, 1000);
+
+	asb->filtered_voltage_uv = clamp_t(int, filt, 0, INT_MAX);
+	return asb->filtered_voltage_uv;
+}
+
+static int asb_filter_capacity(struct adc_simple_battery *asb,
+			       int raw_cap, int status,
+			       int raw_voltage_uv, int filtered_voltage_uv)
+{
+	int cap;
+	int delta_uv = 0;
+
+	if (raw_cap < 0)
+		return raw_cap;
+
+	if (!asb->has_smoothed_capacity) {
+		asb->smoothed_capacity = raw_cap;
+		asb->has_smoothed_capacity = true;
+		return raw_cap;
+	}
+
+	cap = raw_cap;
+	if (asb->has_prev)
+		delta_uv = asb->prev.voltage_uv - raw_voltage_uv;
+
+	if (status == POWER_SUPPLY_STATUS_DISCHARGING &&
+	    cap < asb->smoothed_capacity &&
+	    asb->has_prev &&
+	    delta_uv > 0 &&
+	    delta_uv >= asb->transient_drop_uv) {
+		asb->transient_hold_until =
+			jiffies + msecs_to_jiffies(asb->transient_hold_ms);
+	}
+
+	if (status == POWER_SUPPLY_STATUS_DISCHARGING &&
+	    cap < asb->smoothed_capacity &&
+	    time_before(jiffies, asb->transient_hold_until))
+		cap = asb->smoothed_capacity;
+
+	if (cap > asb->smoothed_capacity + asb->cap_step_up_pct)
+		cap = asb->smoothed_capacity + asb->cap_step_up_pct;
+	if (cap < asb->smoothed_capacity - asb->cap_step_down_pct)
+		cap = asb->smoothed_capacity - asb->cap_step_down_pct;
+
+	asb->smoothed_capacity = clamp_t(int, cap, 0, 100);
+	return asb->smoothed_capacity;
+}
+
+static int asb_sample_state(struct adc_simple_battery *asb, struct asb_state *st)
+{
+	int ret, temp_decic, temp_c;
+	int raw_cap;
+
+	ret = asb_read_voltage_uv(asb, &st->voltage_uv);
+	if (ret)
+		return ret;
+
+	ret = asb_read_temp_decic(asb, &temp_decic);
+	if (ret) {
+		st->temp_decic = 250;
+		temp_c = 25;
+	} else {
+		st->temp_decic = temp_decic;
+		temp_c = temp_decic / 10;
+	}
+
+	raw_cap = asb_get_capacity(asb, st->voltage_uv, temp_c);
+	st->capacity = raw_cap;
+	st->status = asb_get_status(asb, raw_cap >= 0 ? raw_cap : 0);
+
+	return 0;
+}
+
+static int asb_refresh_state_locked(struct adc_simple_battery *asb,
+				    struct asb_state *st)
+{
+	struct asb_state raw;
+	int ret;
+
+	ret = asb_sample_state(asb, &raw);
+	if (ret)
+		return ret;
+
+	st->voltage_uv = asb_filter_voltage_uv(asb, raw.voltage_uv);
+	st->temp_decic = raw.temp_decic;
+	st->capacity = asb_filter_capacity(asb, raw.capacity, raw.status,
+					   raw.voltage_uv, st->voltage_uv);
+	st->status = asb_get_status(asb, st->capacity >= 0 ? st->capacity : 0);
+
+	asb->state = *st;
+	asb->state_valid = true;
+
+	return 0;
+}
+
+static int asb_get_property(struct power_supply *psy,
+			    enum power_supply_property psp,
+			    union power_supply_propval *val)
+{
+	struct adc_simple_battery *asb = power_supply_get_drvdata(psy);
+	struct asb_state st;
+
+	mutex_lock(&asb->lock);
+	if (!asb->state_valid) {
+		mutex_unlock(&asb->lock);
+		return -EAGAIN;
+	}
+	st = asb->state;
+	mutex_unlock(&asb->lock);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = st.status;
+		return 0;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = st.voltage_uv > 0;
+		return 0;
+	case POWER_SUPPLY_PROP_HEALTH:
+		if (asb->info.voltage_max_design_uv > 0 &&
+		    st.voltage_uv > asb->info.voltage_max_design_uv)
+			val->intval = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+		else if (asb->info.voltage_min_design_uv > 0 &&
+			 st.voltage_uv < asb->info.voltage_min_design_uv)
+			val->intval = POWER_SUPPLY_HEALTH_DEAD;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		if (st.capacity < 0)
+			return -ENODATA;
+		val->intval = st.capacity;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
+		if (st.capacity < 0)
+			return -ENODATA;
+		val->intval = asb_capacity_level(st.capacity);
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		val->intval = st.voltage_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		if (asb->info.voltage_min_design_uv < 0)
+			return -ENODATA;
+		val->intval = asb->info.voltage_min_design_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		if (asb->info.voltage_max_design_uv < 0)
+			return -ENODATA;
+		val->intval = asb->info.voltage_max_design_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		if (asb->info.charge_full_design_uah < 0)
+			return -ENODATA;
+		val->intval = asb->info.charge_full_design_uah;
+		return 0;
+	case POWER_SUPPLY_PROP_TEMP:
+		if (!asb->has_temp_channel)
+			return -ENODATA;
+		val->intval = st.temp_decic;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static enum power_supply_property asb_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_TEMP,
+};
+
+static void asb_poll_workfn(struct work_struct *work)
+{
+	struct adc_simple_battery *asb =
+		container_of(to_delayed_work(work), struct adc_simple_battery,
+			     poll_work);
+	struct asb_state cur;
+	bool changed = false;
+
+	mutex_lock(&asb->lock);
+	if (!asb_refresh_state_locked(asb, &cur)) {
+		if (!asb->has_prev) {
+			changed = true;
+		} else if (cur.status != asb->prev.status ||
+			   cur.capacity != asb->prev.capacity ||
+			   abs(cur.voltage_uv - asb->prev.voltage_uv) >=
+				   ASB_VOLTAGE_HYST_UV ||
+			   (asb->has_temp_channel &&
+			    cur.temp_decic != asb->prev.temp_decic)) {
+			changed = true;
+		}
+
+		asb->prev = cur;
+		asb->has_prev = true;
+	}
+	mutex_unlock(&asb->lock);
+
+	if (changed)
+		power_supply_changed(asb->psy);
+
+	schedule_delayed_work(&asb->poll_work,
+			      msecs_to_jiffies(asb->poll_interval_ms));
+}
+
+static int asb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct adc_simple_battery *asb;
+	struct power_supply_config psy_cfg = {};
+	struct asb_state init;
+	u32 tmp;
+	int ret;
+
+	asb = devm_kzalloc(dev, sizeof(*asb), GFP_KERNEL);
+	if (!asb)
+		return -ENOMEM;
+
+	asb->dev = dev;
+	mutex_init(&asb->lock);
+
+	asb->vbat_chan = devm_iio_channel_get(dev, "battery");
+	if (IS_ERR(asb->vbat_chan))
+		return dev_err_probe(dev, PTR_ERR(asb->vbat_chan),
+				     "failed to get battery channel\n");
+
+	asb->temp_chan = devm_iio_channel_get(dev, "temperature");
+	if (IS_ERR(asb->temp_chan)) {
+		if (PTR_ERR(asb->temp_chan) == -ENODEV ||
+		    PTR_ERR(asb->temp_chan) == -ENXIO) {
+			asb->temp_chan = NULL;
+		} else {
+			return dev_err_probe(dev, PTR_ERR(asb->temp_chan),
+					     "failed to get temperature channel\n");
+		}
+	}
+	asb->has_temp_channel = !!asb->temp_chan;
+
+	asb->charge_status_gpiod =
+		devm_gpiod_get_optional(dev, "charge-status", GPIOD_IN);
+	if (IS_ERR(asb->charge_status_gpiod))
+		return dev_err_probe(dev, PTR_ERR(asb->charge_status_gpiod),
+				     "failed to get charge-status gpio\n");
+	asb->use_status_gpio = !!asb->charge_status_gpiod;
+
+	asb->voltage_scale = 1000;
+	ret = device_property_read_u32(dev, "voltage-scale", &tmp);
+	if (!ret) {
+		if (!tmp)
+			return dev_err_probe(dev, -EINVAL,
+					     "voltage-scale must be > 0\n");
+		asb->voltage_scale = tmp;
+	}
+
+	asb->poll_interval_ms = ASB_DEF_POLL_MS;
+	ret = device_property_read_u32(dev, "poll-interval-ms", &tmp);
+	if (!ret && tmp >= 100)
+		asb->poll_interval_ms = tmp;
+
+	asb->filter_alpha_permil = ASB_DEF_FILTER_ALPHA;
+	ret = device_property_read_u32(dev, "voltage-filter-alpha-permil", &tmp);
+	if (!ret && tmp > 0 && tmp <= 1000)
+		asb->filter_alpha_permil = tmp;
+
+	asb->cap_step_up_pct = ASB_DEF_STEP_UP_PCT;
+	ret = device_property_read_u32(dev, "capacity-step-up-percent", &tmp);
+	if (!ret && tmp <= 100)
+		asb->cap_step_up_pct = tmp;
+
+	asb->cap_step_down_pct = ASB_DEF_STEP_DOWN_PCT;
+	ret = device_property_read_u32(dev, "capacity-step-down-percent", &tmp);
+	if (!ret && tmp <= 100)
+		asb->cap_step_down_pct = tmp;
+
+	asb->transient_drop_uv = ASB_DEF_DROP_UV;
+	ret = device_property_read_u32(dev, "transient-drop-microvolt", &tmp);
+	if (!ret)
+		asb->transient_drop_uv = min_t(u32, tmp, INT_MAX);
+
+	asb->transient_hold_ms = ASB_DEF_DROP_HOLD_MS;
+	ret = device_property_read_u32(dev, "transient-hold-ms", &tmp);
+	if (!ret && tmp >= 100)
+		asb->transient_hold_ms = tmp;
+
+	asb->desc.name = dev_name(dev);
+	asb->desc.type = POWER_SUPPLY_TYPE_BATTERY;
+	asb->desc.properties = asb_props;
+	asb->desc.num_properties = ARRAY_SIZE(asb_props);
+	asb->desc.get_property = asb_get_property;
+
+	psy_cfg.drv_data = asb;
+	psy_cfg.of_node = dev->of_node;
+
+	asb->psy = devm_power_supply_register(dev, &asb->desc, &psy_cfg);
+	if (IS_ERR(asb->psy))
+		return dev_err_probe(dev, PTR_ERR(asb->psy),
+				     "failed to register power supply\n");
+
+	ret = power_supply_get_battery_info(asb->psy, &asb->info);
+	if (ret)
+		dev_warn(dev,
+			 "simple-battery info missing, fallback to linear capacity\n");
+
+	platform_set_drvdata(pdev, asb);
+
+	mutex_lock(&asb->lock);
+	ret = asb_refresh_state_locked(asb, &init);
+	if (!ret) {
+		asb->prev = init;
+		asb->has_prev = true;
+	}
+	mutex_unlock(&asb->lock);
+	if (ret)
+		dev_warn(dev, "failed to sample initial battery state: %d\n", ret);
+
+	INIT_DELAYED_WORK(&asb->poll_work, asb_poll_workfn);
+	schedule_delayed_work(&asb->poll_work, msecs_to_jiffies(0));
+
+	return 0;
+}
+
+static int asb_remove(struct platform_device *pdev)
+{
+	struct adc_simple_battery *asb = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&asb->poll_work);
+	power_supply_put_battery_info(asb->psy, &asb->info);
+
+	return 0;
+}
+
+static const struct of_device_id asb_of_match[] = {
+	{ .compatible = "cvitek,adc-simple-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, asb_of_match);
+
+static struct platform_driver asb_driver = {
+	.driver = {
+		.name = "adc-simple-battery",
+		.of_match_table = asb_of_match,
+	},
+	.probe = asb_probe,
+	.remove = asb_remove,
+};
+module_platform_driver(asb_driver);
+
+MODULE_DESCRIPTION("Simple ADC battery driver");
+MODULE_AUTHOR("CVITEK");
+MODULE_LICENSE("GPL");
