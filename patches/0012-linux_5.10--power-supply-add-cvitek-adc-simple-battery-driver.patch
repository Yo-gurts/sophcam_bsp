 	  which uses IIO framework to read adc.
 
+config BATTERY_ADC_SIMPLE
+	tristate "Simple ADC battery with OCV capacity lookup"
+	depends on OF && IIO
+	help
+	  Say Y here to enable a simple ADC based battery driver using
+	  the power_supply framework. The driver reads battery voltage
+	  from IIO, maps voltage to capacity using the simple-battery
+	  OCV table when available, and exposes battery properties via
+	  /sys/class/power_supply.
+
 config MAX8925_POWER
 	tristate "MAX8925 battery charger support"
 	depends on MFD_MAX8925
