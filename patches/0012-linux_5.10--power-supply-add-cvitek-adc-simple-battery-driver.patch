From 8aa3a2acce5be51b9cfd0381f0287dc70554293b Mon Sep 17 00:00:00 2001
From: yogurt <yusong1117.u@gmail.com>
Date: Fri, 27 Mar 2026 03:19:49 +0800
Subject: [PATCH] feat(power): supply: add cvitek adc simple battery driver

- add adc-simple-battery power_supply driver based on IIO ADC
- support simple-battery monitored-battery OCV capacity mapping
- support optional temperature ADC and charge-status GPIO
- add DT binding for cvitek,adc-simple-battery
- wire into Kconfig/Makefile
---
 .../supply/cvitek,adc-simple-battery.yaml     | 131 +++++
 drivers/power/supply/Kconfig                  |  10 +
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/adc-simple-battery.c     | 532 ++++++++++++++++++
 4 files changed, 674 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/cvitek,adc-simple-battery.yaml
 create mode 100644 drivers/power/supply/adc-simple-battery.c

diff --git a/Documentation/devicetree/bindings/power/supply/cvitek,adc-simple-battery.yaml b/Documentation/devicetree/bindings/power/supply/cvitek,adc-simple-battery.yaml
new file mode 100644
index 000000000..ea76129a4
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/cvitek,adc-simple-battery.yaml
@@ -0,0 +1,131 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: "http://devicetree.org/schemas/power/supply/cvitek,adc-simple-battery.yaml#"
+$schema: "http://devicetree.org/meta-schemas/core.yaml#"
+
+title: CVITEK Simple ADC Battery
+
+maintainers:
+  - CVITEK Linux Team
+
+description: |
+  ADC based battery monitor driver. The driver samples battery voltage from IIO
+  and exposes battery properties through power_supply class. Capacity is derived
+  from simple-battery OCV tables when provided, otherwise a linear estimate from
+  voltage-min-design-microvolt to voltage-max-design-microvolt is used.
+
+properties:
+  compatible:
+    const: cvitek,adc-simple-battery
+
+  io-channels:
+    minItems: 1
+    maxItems: 2
+    description: |
+      ADC channels for battery voltage and optional battery temperature.
+
+  io-channel-names:
+    minItems: 1
+    maxItems: 2
+    items:
+      enum:
+        - battery
+        - temperature
+    description: |
+      Must include "battery". "temperature" is optional.
+
+  monitored-battery:
+    description: >
+      Phandle to a "simple-battery" node described by battery.yaml.
+
+  charge-status-gpios:
+    maxItems: 1
+    description: |
+      Optional GPIO indicating charging state. Active state means charging.
+      Use GPIO flags for polarity.
+
+  poll-interval-ms:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 100
+    maximum: 60000
+    default: 5000
+    description: Polling period for power_supply change notifications.
+
+  voltage-scale:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    default: 1000
+    description: |
+      Scale factor applied to ADC processed voltage:
+      voltage_uv = processed_value * voltage-scale / 1000.
+
+  voltage-filter-alpha-permil:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    maximum: 1000
+    default: 250
+    description: |
+      Exponential moving average factor for voltage filtering.
+      1000 means no filtering, lower values mean stronger filtering.
+
+  capacity-step-up-percent:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 0
+    maximum: 100
+    default: 2
+    description: Maximum allowed capacity increase per poll interval.
+
+  capacity-step-down-percent:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 0
+    maximum: 100
+    default: 1
+    description: Maximum allowed capacity decrease per poll interval.
+
+  transient-drop-microvolt:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    default: 120000
+    description: |
+      Instant voltage drop threshold. A larger downward step than this value
+      is considered load transient and capacity drop can be held briefly.
+
+  transient-hold-ms:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 100
+    maximum: 60000
+    default: 3000
+    description: Hold time for transient-drop suppression.
+
+required:
+  - compatible
+  - io-channels
+  - io-channel-names
+
+additionalProperties: false
+
+examples:
+  - |
+    battery_cell: battery {
+      compatible = "simple-battery";
+      voltage-min-design-microvolt = <3300000>;
+      voltage-max-design-microvolt = <4200000>;
+      ocv-capacity-celsius = <25>;
+      ocv-capacity-table-0 = <4200000 100>, <4030000 80>,
+                             <3800000 40>, <3600000 15>, <3300000 0>;
+    };
+
+    adc-battery {
+      compatible = "cvitek,adc-simple-battery";
+      io-channels = <&saradc 3>, <&saradc 4>;
+      io-channel-names = "battery", "temperature";
+      monitored-battery = <&battery_cell>;
+      charge-status-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
+      poll-interval-ms = <3000>;
+      voltage-scale = <1000>;
+      voltage-filter-alpha-permil = <250>;
+      capacity-step-up-percent = <2>;
+      capacity-step-down-percent = <1>;
+      transient-drop-microvolt = <120000>;
+      transient-hold-ms = <3000>;
+    };
