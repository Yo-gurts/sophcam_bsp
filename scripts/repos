    "app": {{ "xml": "../manifest/app.xml", "txt": "../manifest/app_version.txt" }}
  }}
  路径相对于配置文件所在目录

{Colors.YELLOW}基本用法:{Colors.NC}
  {sys.argv[0]} [选项] <命令>

{Colors.YELLOW}核心命令:{Colors.NC}
  --gitclone              克隆所有仓库（按配置文件）
  --save [txt]            保存所有仓库当前 commit_id
  --reproduce             复现仓库到指定 commit（按 txt 文件）
