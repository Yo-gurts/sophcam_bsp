#!/bin/sh
${CVI_SHOPTS}
#
# Start firmware
#
export USERDATAPATH=/mnt/data/
export SYSTEMPATH=/system/
export DEFAULT_WPA_CONF=/etc/wpa_supplicant.conf
export USER_WPA_CONF=/mnt/data/wpa_supplicant.conf

case "$1" in
  start)
        cvi_pinmux -w JTAG_CPU_TCK/PWM_6
        echo "init mpp system..."
        if [ -f $SYSTEMPATH/ko/loadsystemko.sh ]; then
                sh $SYSTEMPATH/ko/loadsystemko.sh
        fi

        echo "Starting app..."
        if [ -f $USERDATAPATH/auto.sh ]; then
                usleep 30000
                . $USERDATAPATH/auto.sh &
                exit 1
        fi
        if [ -f $SYSTEMPATH/auto.sh ]; then
                usleep 30000
                . $SYSTEMPATH/auto.sh &
        fi

        ulimit -c unlimited

        # reset sensor(B26)
        echo 474 > /sys/class/gpio/export
        echo out > /sys/class/gpio/gpio474/direction
        echo 1 > /sys/class/gpio/gpio474/value
        echo 474 > /sys/class/gpio/unexport

        # record alios log
        alios_cli -m 1 -c 0 2>&1 | logger -t alios -p local7.info &

        # run sophcam
        if [ -f /app/bin/sophcam ]; then
                chmod +x /app/bin/sophcam
                /app/bin/sophcam </dev/null 2>&1 | logger -t sophcam &
        fi

        # keep runtime-modifiable wpa_supplicant config in /mnt/data
        if [ ! -s "$USER_WPA_CONF" ] && [ -f "$DEFAULT_WPA_CONF" ]; then
                cp -f "$DEFAULT_WPA_CONF" "$USER_WPA_CONF"
        fi
        # run wpa_supplicant after app start
        wpa_supplicant -D nl80211 -i wlan0 -c "$USER_WPA_CONF" -B
        wifi-daemon -l info &

        ;;
  stop)
        ;;
  restart|reload)
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
